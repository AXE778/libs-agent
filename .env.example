# ==========================================================
# 这是配置模板，可以提交到 Git。
# 真正生效的是同目录下的 .env（已被 .gitignore 忽略）。
# 新同事 / 新电脑上：复制本文件为 .env，再填上自己的 Key。
# ==========================================================

# 【第一步：选服务商】填 ark（豆包）/ kimi / sensenova（商汤日日新）。
# 换厂商只改这一个词，代码一行都不用动。
LLM_PROVIDER=ark


# ---------- 豆包（火山方舟）----------
# 获取地址：https://console.volcengine.com/ark  ->  「API Key 管理」-> 创建
ARK_API_KEY=your_ark_api_key_here


# ---------- Kimi（Moonshot AI）----------
# 获取地址：https://platform.moonshot.cn/console/api-keys  ->  新建 API Key
# 注意：限流很紧（本机实测每分钟只有 3 次请求），带工具的一轮问答必撞 429。
KIMI_API_KEY=your_kimi_api_key_here


# ---------- 商汤日日新（SenseNova）----------
# 获取地址：https://platform.sensenova.cn/console/keys  ->  创建 API Key
# 这个平台的对话模型栏是个聚合网关，除自家模型外还挂着
# deepseek-v4-pro / deepseek-v4-flash / glm-5.2 / kimi-k3。
# 默认用 sensenova-6.8-flash-lite：轻量、限流最宽松，适合本项目这种
# 「一轮问答要连调好几次工具」的用法。
SENSENOVA_API_KEY=your_sensenova_api_key_here


# ==========================================================
# 高级选项：一般不用动。想临时换模型版本时再打开注释。
# 留空则使用 agent/llm_client.py 里各服务商的默认模型。
#
# 注意：LLM_MODEL 是「全局覆盖」，不属于某个服务商。
#       换服务商时记得把它注释掉，否则会把 Kimi 的模型名发给豆包。
# ==========================================================
# LLM_MODEL=
#   ark       : doubao-seed-2-1-pro-260628（想一直用最新版可写 doubao-seed-evolving）
#   kimi      : kimi-k2.6 / kimi-k2.7-code
#               （kimi-k3 是旗舰，但需账号有权限，否则报「模型不存在」；
#                 用 check_models.py 查你的账号实际能用哪些）
#   sensenova : sensenova-6.8-flash-lite / deepseek-v4-flash /
#               deepseek-v4-pro / glm-5.2 / kimi-k3
#               （sensenova-u1-fast 是文生图专用，不能填这里）
# LLM_BASE_URL=
#   ark       : https://ark.cn-beijing.volces.com/api/v3
#   kimi      : https://api.moonshot.cn/v1
#   sensenova : https://token.sensenova.cn/v1


# ==========================================================
# 代理开关（本机踩过的坑，默认不用管）
#
# 背景：本机 Windows 系统代理开着（127.0.0.1:7890）。openai SDK 默认用 httpx，
#       而 httpx 默认 trust_env=True，会**静默**把系统代理套到每个请求上。
#       实测走这个代理时，api.moonshot.cn 和 token.sensenova.cn 都会报
#       ConnectError: [SSL: UNEXPECTED_EOF_WHILE_READING]（TLS 被掐断）。
#
# 所以客户端默认已经绕开系统代理直连（trust_env=False），**这两行留空即可**。
# 只有当你确实需要走代理（例如以后接 OpenAI）才取消注释：
# LLM_PROXY=http://127.0.0.1:7890
# ==========================================================
